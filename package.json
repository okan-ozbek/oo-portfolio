{
  "name": "pixelware-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "admin:password": "node scripts/admin-password.mjs",
    "admin:setup": "node scripts/admin-password.mjs --local",
    "books:import": "node scripts/import-books.mjs",
    "resume:compiler": "docker compose -p pixelware-resume-dev -f compose.compiler-dev.yaml up -d --build --wait --wait-timeout 90",
    "test:resumes:compiler": "node scripts/smoke-resume-compiler.mjs",
    "test:admin": "node scripts/build-home.mjs && node --test tests/admin.test.mjs tests/resumes.test.mjs tests/books.test.mjs tests/blogs.test.mjs tests/markdown-editor.test.mjs tests/projects.test.mjs tests/view-analytics.test.mjs",
    "build:blog": "node scripts/build-blog.mjs",
    "test:admin:container": "node scripts/smoke-admin-container.mjs",
    "test:deploy": "node scripts/smoke-deploy.mjs",
    "build": "node scripts/build-static.mjs",
    "build:static": "npm run build",
    "start": "vite preview --host 127.0.0.1 --outDir dist/client",
    "test": "npm run build && npm run test:static && npm run test:admin",
    "test:static": "node --experimental-strip-types --test tests/static-export.test.mjs tests/animation-clock.test.mjs",
    "test:container": "node scripts/smoke-container.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.31.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "next": "16.2.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module"
}
