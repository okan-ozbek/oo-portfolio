FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    texlive-xetex texlive-latex-extra texlive-fonts-recommended fonts-dejavu-core fonts-texgyre \
    python3-pypdf poppler-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --chown=node:node server/http.mjs server/resume-project.mjs ./server/
COPY --chown=node:node server/compiler/ ./server/compiler/
USER node
EXPOSE 3032
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3032/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server/compiler/worker.mjs"]
