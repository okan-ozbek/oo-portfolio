FROM node:22-bookworm-slim AS blog-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY scripts/build-blog.mjs ./scripts/build-blog.mjs
COPY server/blog/mermaid.js ./server/blog/mermaid.js
RUN node scripts/build-blog.mjs && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=node:node server/ ./server/
COPY --from=blog-build --chown=node:node /app/node_modules ./node_modules
COPY --from=blog-build --chown=node:node /app/server/blog/vendor/ ./server/blog/vendor/
RUN mkdir /data && chown node:node /data
USER node
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3031 ADMIN_DB_PATH=/data/admin.sqlite
EXPOSE 3031
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3031/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server/admin-server.mjs"]
